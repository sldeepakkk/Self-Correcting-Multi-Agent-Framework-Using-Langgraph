# ------------------------------------------------------------------------------
# 1. LLM API Keys
# ------------------------------------------------------------------------------
# Groq API Key (Default provider for Llama 3.3 70B & Llama 3.1 8B)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Alternative / mixed provider for Gemini 2.5 Flash)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Live Web Search & Market Data
# ------------------------------------------------------------------------------
# Tavily API Key (Used for CRAG corrective search and live market filings)
# Get a key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here
